# Copy to .env and fill in real values. Never commit .env.
# Every variable carries the VAULT_ prefix.

# Async SQLAlchemy URL. Local development uses SQLite through aiosqlite.
VAULT_DATABASE_URL=sqlite+aiosqlite:///./vault.db

# JWT signing key, at least 32 characters. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
VAULT_JWT_SECRET_KEY=

# Fernet keys for encrypting vault items, comma-separated; the first one encrypts,
# all of them decrypt (for key rotation). Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back it up: losing every key loses every stored credential.
VAULT_FERNET_KEYS=

# Optional overrides (defaults shown).
# VAULT_APP_NAME=Secure Credential Vault API
# VAULT_DEBUG=false
# VAULT_SQL_ECHO=false
# VAULT_HOST=127.0.0.1
# VAULT_PORT=8000
# VAULT_ACCESS_TOKEN_TTL_MINUTES=15
