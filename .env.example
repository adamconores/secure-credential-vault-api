# Copy to .env and fill in real values. Never commit .env.
# Every variable carries the VAULT_ prefix.

# Async SQLAlchemy URL. Local development uses SQLite through aiosqlite.
VAULT_DATABASE_URL=sqlite+aiosqlite:///./vault.db

# Optional overrides (defaults shown).
# VAULT_APP_NAME=Secure Credential Vault API
# VAULT_DEBUG=false
# VAULT_SQL_ECHO=false
# VAULT_HOST=127.0.0.1
# VAULT_PORT=8000

# Phase 3 (not read yet; leave commented until the settings exist):
# VAULT_JWT_SECRET_KEY=
# VAULT_FERNET_KEY=
